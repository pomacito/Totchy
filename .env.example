# Скопіюйте цей файл у .env та заповніть значення для локальної розробки.
# Не додавайте .env із реальними секретами до системи контролю версій.

# --- База даних ---------------------------------------------------------
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/status_terytorii?schema=public"

# --- Застосунок -----------------------------------------------------------
# Базова URL-адреса, за якою доступний застосунок (використовується для
# генерації стабільних посилань на звіти).
APP_BASE_URL="http://localhost:3000"

# Секрет для підпису сесійних cookie адміністративної панелі.
# Згенеруйте власне значення, напр.: openssl rand -hex 32
APP_SESSION_SECRET="change-me-to-a-random-64-character-hex-string"

# --- Об'єктне сховище (звіти, первинні файли джерел) -----------------------
# Для локальної розробки за замовчуванням використовується сховище на диску
# (STORAGE_DRIVER=local). Для S3-сумісного сховища встановіть значення "s3"
# і заповніть параметри нижче.
STORAGE_DRIVER="local"
STORAGE_LOCAL_DIR="./.storage"
S3_ENDPOINT=""
S3_BUCKET=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_REGION=""

# --- Демонстраційні дані ----------------------------------------------------
# Якщо true, застосунок показує явне попередження про демонстраційний набір
# даних на кожній сторінці, де відображаються записи, позначені isDemoData.
DEMO_DATA_MODE="true"
